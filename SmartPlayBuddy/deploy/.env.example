# SmartPlayBuddy 环境变量模板
# 复制为 .env（项目根）或 deploy/.env，按环境修改；真实 .env 不入库。
# 所有变量均可用系统环境变量覆盖（优先级：系统环境变量 > .env > 代码默认值）。

# ── 服务器端地址（Client / Mod / Web 桥接层共用）──
SPB_SERVER_HOST=https://smtplay.cabyss.cn
SPB_WS_URL=wss://smtplay.cabyss.cn/ws

# ── Web 桥接服务（web/backend/app.py）──
# 监听端口；host 一般由启动参数 --host 指定
SPB_WEB_PORT=8765

# ── 出站代理（2026-09-16 新增，按需启用）──
# 若部署机的网络必须经代理才能访问 smtplay 服务器（容器不走宿主机系统代理，
# 直连会报 Remote end closed connection without response），取消注释以下三行。
# 说明：
#   - host.docker.internal 在 Docker Desktop(Windows/Mac) 下指向宿主机；
#     Linux 需在 compose 的 webapi 下额外加 extra_hosts: ["host.docker.internal:host-gateway"]
#   - 7897 是 Clash Verge 默认混合端口；同时需在代理软件里开启「允许局域网连接」，
#     否则代理只监听 127.0.0.1，容器连不进来
#   - webapi 的 urllib 与 websockets 客户端均会自动读取这两个环境变量
# HTTPS_PROXY=http://host.docker.internal:7897
# HTTP_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1,webapi
